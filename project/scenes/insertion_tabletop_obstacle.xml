    <!-- The rod across the left gripper's fingers, the container held by its base in the right gripper (scenes/insertion.xml).
         The rod is free: the left fingers hold it, and it falls when they open (into the container, at the end). It
         also lands on the table (contype/conaffinity 10: the container's bit 8 and the table's bit 2). -->
    <body name="rod@EE_BODY_L" pos="0 -0.03 -0.08" quat="0.7071068 0.7071068 0 0">
      <freejoint/>
      <geom name="rod" type="cylinder" size="0.014 0.05" rgba="0.85 0.20 0.10 1" contype="0" conaffinity="0" group="1" mass="0"/>
